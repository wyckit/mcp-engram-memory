<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Debugging Symbols -->
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>

    <!-- NuGet Package -->
    <PackageId>McpEngramMemory.Core</PackageId>
    <Version>1.6.0</Version>
    <Authors>wyckit</Authors>
    <Company>wyckit</Company>
    <Copyright>Copyright (c) 2026 WyckIt</Copyright>
    <Description>Cognitive engram memory engine with semantic search, knowledge graphs, clustering, lifecycle management, and hierarchical expert routing (HMoE). Core library for MCP Engram Memory.</Description>
    <PackageTags>mcp;engram;vector;memory;embeddings;semantic-search;knowledge-graph;expert-routing;hmoe</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wyckit/mcp-engram-memory</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/wyckit/mcp-engram-memory</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/wyckit/mcp-engram-memory/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- This assembly ships as a NuGet package, so its public surface is a semver commitment.
         Seams that exist only so a test can drive a deterministic pass stay internal and are
         reached through here, rather than being widened to public for the test's convenience. -->
    <InternalsVisibleTo Include="McpEngramMemory.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\images\icon.png" Pack="true" PackagePath="\" />
    <None Include="build\McpEngramMemory.Core.targets" Pack="true" PackagePath="build\" />
    <None Include="buildMultiTargeting\McpEngramMemory.Core.targets" Pack="true" PackagePath="buildMultiTargeting\" />
  </ItemGroup>

  <Import Project="build\McpEngramMemory.Core.targets" />

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="FastBertTokenizer" Version="1.0.28" />
    <!-- Kept current with the optional ONNX Runtime GenAI backend so embedding and
         synthesis use one compatible native runtime. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
    <!-- In-process SLM generation for SynthesisEngine (Qwen2.5-0.5B). CPU package; bring in
         Microsoft.ML.OnnxRuntimeGenAI.Cuda / .DirectML at the app layer for GPU acceleration. -->
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Keep the native SQLite bundle explicit so its security servicing cadence is not
         limited to Microsoft.Data.Sqlite's transitive minimum version. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
  </ItemGroup>

</Project>
