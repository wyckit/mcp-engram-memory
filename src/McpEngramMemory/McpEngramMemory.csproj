<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Debugging Symbols — matched to the two library packages, so a stack trace out of
         the shipped tool resolves to source the same way one out of Core does. -->
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>

    <!-- dotnet global tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>engram-memory</ToolCommandName>

    <!-- NuGet Package -->
    <PackageId>McpEngramMemory</PackageId>
    <Version>2.1.0</Version>
    <Authors>wyckit</Authors>
    <Company>wyckit</Company>
    <Copyright>Copyright (c) 2026 WyckIt</Copyright>
    <Description>Cognitive memory MCP server with vector search, knowledge graph, lifecycle management, and hierarchical expert routing. Install as a dotnet global tool for single-line setup.</Description>
    <PackageTags>mcp;engram;memory;ai;vector-search;knowledge-graph;expert-routing;model-context-protocol;dotnet-tool</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wyckit/mcp-engram-memory</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/wyckit/mcp-engram-memory</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>2.1.0 improves scoped recall, contradiction handling and persistence reliability; adds safe pre-update data migration and early ONNX telemetry suppression. MCP tool names and arguments remain compatible. Back up and migrate version-local 2.0.0 data before updating. Release notes: https://github.com/wyckit/mcp-engram-memory/blob/main/docs/release-notes-2.1.0.md</PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\images\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    Drop native runtimes and C++ link libraries this server cannot use.

    1. Mobile/WASM RIDs (ios-*, android-*, maccatalyst-*, browser-*): a console stdio global
       tool on .NET 8 cannot execute on these platforms (~81 MB).
    2. Dead SQLite/SNI-only RIDs where Microsoft.ML.OnnxRuntime does NOT ship a native binary
       (linux-arm, linux-armel, linux-mips64, linux-musl-*, linux-ppc64le, linux-riscv64,
       linux-s390x, linux-x86, osx-x64, win-x86) (~10.1 MB compressed). Because
       OnnxEmbeddingService requires onnxruntime at startup, the server cannot run on those
       platforms regardless. The 5 supported desktop/server native RIDs (win-x64, win-arm64,
       linux-x64, linux-arm64, osx-arm64) and managed RIDs (win, unix) are kept intact.
    3. Windows C++ static import libraries (*.lib) under runtimes/*/native/: only needed by
       native C++ linkers, never loaded by the .NET runtime.

    If ONNX Runtime ever gains a supported platform RID, remove it from _UnsupportedNativeRidFiles.
  -->
  <Target Name="TrimNonDesktopNativeRuntimes" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_NonDesktopRuntimeFiles Include="@(ResolvedFileToPublish)"
                               Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes[/\\](ios|android|maccatalyst|browser)[^/\\]*[/\\]'))" />
      <_UnsupportedNativeRidFiles Include="@(ResolvedFileToPublish)"
                                  Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes[/\\](linux-arm|linux-armel|linux-mips64|linux-musl-[^/\\]+|linux-ppc64le|linux-riscv64|linux-s390x|linux-x86|osx-x64|win-x86)[/\\]'))" />
      <_NativeLinkLibraries Include="@(ResolvedFileToPublish)"
                            Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '^runtimes[/\\][^/\\]+[/\\]native[/\\].*\.lib$'))" />
      <ResolvedFileToPublish Remove="@(_NonDesktopRuntimeFiles)" />
      <ResolvedFileToPublish Remove="@(_UnsupportedNativeRidFiles)" />
      <ResolvedFileToPublish Remove="@(_NativeLinkLibraries)" />
    </ItemGroup>
    <Message Importance="high"
             Text="TrimNonDesktopNativeRuntimes: excluded @(_NonDesktopRuntimeFiles->Count()) mobile/wasm file(s), @(_UnsupportedNativeRidFiles->Count()) unsupported-RID file(s), and @(_NativeLinkLibraries->Count()) C++ .lib file(s)." />
  </Target>

  <ItemGroup>
    <!-- Tool-boundary normalizers are internal; the test project covers them directly. -->
    <InternalsVisibleTo Include="McpEngramMemory.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McpEngramMemory.Core\McpEngramMemory.Core.csproj" />
  </ItemGroup>

</Project>
