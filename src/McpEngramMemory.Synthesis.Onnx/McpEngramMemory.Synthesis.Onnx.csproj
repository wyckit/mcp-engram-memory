<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Debugging Symbols -->
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>

    <!-- NuGet Package -->
    <PackageId>McpEngramMemory.Synthesis.Onnx</PackageId>
    <Version>2.0.0</Version>
    <Authors>wyckit</Authors>
    <Company>wyckit</Company>
    <Copyright>Copyright (c) 2026 WyckIt</Copyright>
    <Description>In-process ONNX Runtime GenAI text-generation backend for MCP Engram Memory synthesis. Optional companion to McpEngramMemory.Core: install it only if you want map-reduce memory synthesis to run fully in-process instead of against an Ollama daemon. Carries the ONNX Runtime GenAI native runtimes, which are large — see the package README.</Description>
    <PackageTags>mcp;engram;memory;synthesis;onnx;onnxruntime-genai;slm;local-llm</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wyckit/mcp-engram-memory</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/wyckit/mcp-engram-memory</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>2.0.0 is a breaking release for hosts embedding McpEngramMemory.Core: tenantId is now a required argument on 55 Core retrieval and scoping APIs. The MCP tool surface and on-disk data are unchanged. Release notes: https://github.com/wyckit/mcp-engram-memory/blob/main/docs/release-notes-2.0.0.md</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\images\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McpEngramMemory.Core\McpEngramMemory.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reason this package exists. ONNX Runtime GenAI ships native binaries for every
         RID (linux-x64/arm64, osx-x64/arm64, win-x64/arm64, iOS xcframeworks, Android aars),
         roughly 500 MB in total. Keeping it here rather than in Core means neither the
         McpEngramMemory tool package nor a plain Core install pays that cost.

         In-process SLM generation for SynthesisEngine (Qwen2.5-0.5B). This is the CPU
         package; bring in Microsoft.ML.OnnxRuntimeGenAI.Cuda / .DirectML at the app layer
         for GPU acceleration. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.15.2" />

    <!-- 0.15.2 declares ONNX Runtime >= 1.28.0; Core pins 1.29.0, so NuGet unifies the
         native runtime up to 1.29.0 whether or not this line exists. It exists so the
         version this package actually loads is visible here rather than inferred from a
         transitive graph — if a future GenAI release needs an exact ORT, this is the line
         that has to change, and it should change together with Core's pin. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.29.0" />
  </ItemGroup>

</Project>
