<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Debugging Symbols -->
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>

    <!-- NuGet Package -->
    <PackageId>McpEngramMemory.Synthesis.Onnx</PackageId>
    <Version>1.5.0</Version>
    <Authors>wyckit</Authors>
    <Company>wyckit</Company>
    <Copyright>Copyright (c) 2026 WyckIt</Copyright>
    <Description>In-process ONNX Runtime GenAI text-generation backend for MCP Engram Memory synthesis. Optional companion to McpEngramMemory.Core: install it only if you want map-reduce memory synthesis to run fully in-process instead of against an Ollama daemon. Carries the ONNX Runtime GenAI native runtimes, which are large — see the package README.</Description>
    <PackageTags>mcp;engram;memory;synthesis;onnx;onnxruntime-genai;slm;local-llm</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/wyckit/mcp-engram-memory</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/wyckit/mcp-engram-memory</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/wyckit/mcp-engram-memory/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\images\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\McpEngramMemory.Core\McpEngramMemory.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The reason this package exists. ONNX Runtime GenAI ships native binaries for every
         RID (linux-x64/arm64, osx-x64/arm64, win-x64/arm64, iOS xcframeworks, Android aars),
         roughly 500 MB in total. Keeping it here rather than in Core means neither the
         McpEngramMemory tool package nor a plain Core install pays that cost. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntimeGenAI" Version="0.14.1" />
  </ItemGroup>

</Project>
