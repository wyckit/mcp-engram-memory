{
  "version": 1,
  "description": "Fictional operational memories with 24 development and 12 held-out paraphrase questions. Labels are authored from source facts, not model judgments.",
  "entries": [
    {
      "id": "atlas-timeout-old",
      "ns": "expert_atlas",
      "text": "Superseded Atlas payment timeout decision from April: use a 30 second gateway timeout. Replaced by the May incident review.",
      "state": "ltm",
      "summary": false,
      "obsolete": true
    },
    {
      "id": "atlas-timeout",
      "ns": "expert_atlas",
      "text": "Current Atlas payment gateway timeout is 45 seconds after the May incident review. This replaces the earlier 30 second setting.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-owner-old",
      "ns": "expert_atlas",
      "text": "Historical Atlas deployment owner was Maya. This ownership record is obsolete after the platform handover.",
      "state": "ltm",
      "summary": false,
      "obsolete": true
    },
    {
      "id": "atlas-owner",
      "ns": "expert_atlas",
      "text": "After the platform handover, Leon owns Atlas production deployments and approves rollback requests.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-region-old",
      "ns": "expert_atlas",
      "text": "Superseded Atlas primary database region was us-east-1. This was the location before the June migration.",
      "state": "ltm",
      "summary": false,
      "obsolete": true
    },
    {
      "id": "atlas-region",
      "ns": "expert_atlas",
      "text": "Atlas primary database moved to eu-west-1 in June; eu-central-1 is the disaster recovery region.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-endpoint",
      "ns": "expert_atlas",
      "text": "Atlas production health endpoint is /v2/health/ready on port 8443. The readiness probe must use HTTPS.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-rollback",
      "ns": "expert_atlas",
      "text": "Atlas rollback command: deployctl rollback atlas --release 42. Before executing, pause the payment consumer.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-error",
      "ns": "expert_atlas",
      "text": "Atlas error PAY-4097 means the payment idempotency key was reused with a different amount. Return HTTP 409.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-backup",
      "ns": "expert_atlas",
      "text": "Atlas PostgreSQL backups run at 02:15 UTC every day and are retained for 35 days.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-queue",
      "ns": "expert_atlas",
      "text": "Atlas payments use the atlas-payments-v2 queue. Dead letters go to atlas-payments-dlq after five attempts.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-secrets",
      "ns": "expert_atlas",
      "text": "Atlas deployment credentials live in the atlas-prod vault under deploy-token. Rotate them every 90 days.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "boreal-timeout",
      "ns": "expert_boreal",
      "text": "Boreal payment gateway timeout remains 30 seconds; it did not adopt the Atlas 45 second timeout.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "boreal-endpoint",
      "ns": "expert_boreal",
      "text": "Boreal production readiness endpoint is /healthz on port 8080. Internal probes use HTTP.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "boreal-backup",
      "ns": "expert_boreal",
      "text": "Boreal PostgreSQL backups run at 04:00 UTC daily and are retained for 14 days.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "boreal-owner",
      "ns": "expert_boreal",
      "text": "Maya owns Boreal production deployments. Escalate Boreal release approvals to Maya.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "boreal-queue",
      "ns": "expert_boreal",
      "text": "Boreal payments use boreal-payments-v1 with three retries before the dead-letter queue.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "boreal-region",
      "ns": "expert_boreal",
      "text": "Boreal primary database remains in us-east-1; its disaster recovery database is in us-west-2.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-cache",
      "ns": "expert_engram",
      "text": "Engram context block version is a SHA-256 content fingerprint covering namespace, ordered memory content, metadata and the optional header.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-cache-header",
      "ns": "expert_engram",
      "text": "Set includeHeader to false on get_context_block to prevent cache invalidation caused only by changing STM, LTM or archived counts.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-specific",
      "ns": "expert_engram",
      "text": "Engram specific spectral recall preserves relevance scores and adds a bounded specificity bonus of at most 25 percent to retrieved candidates.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-broad",
      "ns": "expert_engram",
      "text": "Engram broad recall boosts a dominant graph cluster when it has a strict majority of the top results; ambiguous clusters are left alone.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-identity",
      "ns": "expert_engram",
      "text": "Engram child agents currently share the default agent identity. Namespace ownership is not a security boundary until unique AGENT_ID values are verified.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-profiles",
      "ns": "expert_engram",
      "text": "Engram minimal profile exposes 17 MCP tools, standard 39 and full 63, verified against runtime registration.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-persistence",
      "ns": "expert_engram",
      "text": "Engram persistence flushes pending memory writes on shutdown. Restart must reload archived state and graph edges from disk.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-duplicates",
      "ns": "expert_engram",
      "text": "Engram graph adjacency uses bare IDs within a tenant. Duplicate memory IDs across namespaces must not be traversed as a shared graph node.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-routing",
      "ns": "expert_engram",
      "text": "Engram recall with a namespace searches directly. Without a namespace it tries an expert and otherwise broadcasts across readable namespaces.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-retry",
      "ns": "expert_atlas",
      "text": "Atlas clients retry transient HTTP 503 failures with exponential backoff, capped at five attempts.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-drill",
      "ns": "expert_atlas",
      "text": "Atlas disaster recovery drills happen on the first Tuesday of each quarter. The recovery time objective is 40 minutes.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "boreal-retry",
      "ns": "expert_boreal",
      "text": "Boreal clients retry transient HTTP 503 failures at most three times with jitter.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "boreal-drill",
      "ns": "expert_boreal",
      "text": "Boreal disaster recovery drill is monthly. Its recovery time objective is 90 minutes.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-summary",
      "ns": "expert_atlas",
      "text": "Atlas operations overview: payment gateway, deployment ownership, database regions, health endpoints, backups, rollback and credential rotation.",
      "state": "ltm",
      "summary": true,
      "obsolete": false
    },
    {
      "id": "boreal-summary",
      "ns": "expert_boreal",
      "text": "Boreal operations overview: gateway configuration, production deployments, database backups, readiness probes and disaster recovery.",
      "state": "ltm",
      "summary": true,
      "obsolete": false
    },
    {
      "id": "engram-summary",
      "ns": "expert_engram",
      "text": "Engram memory architecture overview: context caching, retrieval ranking, graph expansion, namespace permissions, tool profiles and persistence.",
      "state": "ltm",
      "summary": true,
      "obsolete": false
    },
    {
      "id": "atlas-incident",
      "ns": "expert_atlas",
      "text": "Archived incident INC-742: Atlas duplicate payments were caused by a missing idempotency key in the retry worker. The repair added the key before retrying.",
      "state": "archived",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-cert",
      "ns": "expert_atlas",
      "text": "Archived incident TLS-318: Atlas certificate renewal failed because the DNS challenge record was missing. Recreate _acme-challenge.atlas.example.",
      "state": "archived",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "boreal-incident",
      "ns": "expert_boreal",
      "text": "Archived incident INC-861: Boreal lost messages because queue acknowledgements happened before database commit. Acknowledge after commit.",
      "state": "archived",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "boreal-restore",
      "ns": "expert_boreal",
      "text": "Archived Boreal restore rehearsal REST-19 recovered the database from snapshot boreal-2026-06-14. The rehearsal took 22 minutes.",
      "state": "archived",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-incident",
      "ns": "expert_engram",
      "text": "Archived Engram incident MEM-212: stale context blocks resulted from a cache version that omitted metadata. Hash all returned content to invalidate correctly.",
      "state": "archived",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-restart",
      "ns": "expert_engram",
      "text": "Archived Engram restart incident MEM-309: pending writes were missing after abrupt process termination. Flush persisted data before a graceful restart.",
      "state": "archived",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "cedar-port",
      "ns": "expert_cedar",
      "text": "Cedar readiness probes use /ready on port 9090. Its service is a reporting dashboard.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "cedar-backup",
      "ns": "expert_cedar",
      "text": "Cedar analytics backups run weekly on Sunday with 60 day retention.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "cedar-owner",
      "ns": "expert_cedar",
      "text": "Priya owns Cedar releases. Release 42 upgraded the reporting dashboard.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "cedar-timeout",
      "ns": "expert_cedar",
      "text": "Cedar report generation timeout is 120 seconds. Payment timeouts are unrelated.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "cedar-summary",
      "ns": "expert_cedar",
      "text": "Cedar analytics combines monthly revenue reporting, dashboards and export scheduling.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-ui",
      "ns": "expert_atlas",
      "text": "Atlas dashboard theme uses navy and amber. The settings page supports keyboard navigation.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "atlas-docs",
      "ns": "expert_atlas",
      "text": "Atlas onboarding documentation is reviewed every second Friday by the support team.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "boreal-ui",
      "ns": "expert_boreal",
      "text": "Boreal mobile app uses green status icons and has an offline mode for field teams.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "boreal-docs",
      "ns": "expert_boreal",
      "text": "Boreal onboarding guide covers local development, debugging and demo accounts.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-model",
      "ns": "expert_engram",
      "text": "Engram uses a local ONNX embedding model to convert memory text into semantic vectors.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-metrics",
      "ns": "expert_engram",
      "text": "Engram metrics collect tool latency, retrieval counts and background worker health.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    },
    {
      "id": "engram-summary-next",
      "ns": "expert_engram",
      "text": "Future work on Engram summary selection should compare summaries against original evidence and preserve useful source memories.",
      "state": "ltm",
      "summary": false,
      "obsolete": false
    }
  ],
