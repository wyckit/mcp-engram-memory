<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- Many concurrency and cancellation tests deliberately own their timeout tokens.
         Applying xUnit's ambient token mechanically would change what those tests prove. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\McpEngramMemory\McpEngramMemory.csproj" />
    <ProjectReference Include="..\..\src\McpEngramMemory.Core\McpEngramMemory.Core.csproj" />
    <!-- Optional synthesis backend, referenced here so the live ONNX synthesis tests
         (LiveSynthesisInferenceTests, ModelSpeedComparisonTests) still build and run.
         The server deliberately does NOT reference it — see Program.cs. -->
    <ProjectReference Include="..\..\src\McpEngramMemory.Synthesis.Onnx\McpEngramMemory.Synthesis.Onnx.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
